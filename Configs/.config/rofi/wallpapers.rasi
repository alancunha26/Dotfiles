@theme "fullscreen"

/*****----- Configuration -----*****/
configuration {
    show-icons:                 true;
}

entry {
    placeholder:                "Search wallpapers";
}

listview {
    columns:                    4;
    lines:                      3;
}

element-icon {
    size:                       240px;
}
