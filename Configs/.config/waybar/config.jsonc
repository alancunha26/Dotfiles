{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 40,
  // ====================
  // === MODULES LEFT ===
  // ====================
  "modules-left": [
    "custom/appmenu",
    "hyprland/workspaces"
  ],
  "hyprland/workspaces": {
    "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({ workspace = 'r-1' })\"",
    "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({ workspace = 'r+1' })\"",
    "on-click": "activate",
    "active-only": false,
    "all-outputs": true,
    "format": "{}",
    "format-icons": {
      "urgent": "",
      "active": "",
      "default": ""
    },
    // explicit ids: "*": N numbers them from the monitor id (id*N+1..), and the
    // monitor id grows when it reconnects (DPMS/hotplug), giving 6-10 instead of 1-5
    "persistent-workspaces": {
      "1": [], "2": [], "3": [], "4": [], "5": []
    }
  },
  "custom/appmenu": {
    "format": "󰣇",
    "on-click": "sleep 0.2;pkill rofi || $HOME/.config/rofi/launcher.sh",
    "on-click-right": "sleep 0.2;pkill rofi || $HOME/.config/rofi/launcher.sh",
    "tooltip-format": "Left click: Open application launcher\nRight click: Open system menu"
  },
  // ======================
  // === MODULES CENTER ===
  // ======================
  "modules-center": [
    "hyprland/window"
  ],
  "hyprland/window": {
    "format": "{title}",
    "max-length": 80
  },
  // =====================
  // === MODULES RIGHT ===
  // =====================
  "modules-right": [
    "group/systray",
    "group/music",
    "wireplumber#sink",
    "wireplumber#source",
    "idle_inhibitor",
    "cpu",
    "network",
    "custom/recording",
    "custom/notification",
    "clock"
  ],
  // ======================
  "group/music": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "music-group-item"
    },
    "modules": [
      "custom/music",
      "custom/music-title",
      "custom/music-prev",
      "custom/music-play",
      "custom/music-next"
    ]
  },
  "custom/music": {
    "exec": "$HOME/.local/bin/music bar icon",
    "return-type": "json",
    "on-click": "$HOME/.local/bin/music show"
  },
  "custom/music-title": {
    "exec": "$HOME/.local/bin/music bar title",
    "return-type": "json",
    "escape": true,
    "on-click": "$HOME/.local/bin/music show"
  },
  "custom/music-prev": {
    "format": "",
    "tooltip": false,
    "on-click": "$HOME/.local/bin/music prev"
  },
  "custom/music-play": {
    "exec": "$HOME/.local/bin/music bar play",
    "return-type": "json",
    "tooltip": false,
    "on-click": "$HOME/.local/bin/music toggle"
  },
  "custom/music-next": {
    "format": "",
    "tooltip": false,
    "on-click": "$HOME/.local/bin/music next"
  },
  "custom/notification": {
    // swaync's count and do-not-disturb, yellow/red when dots needs attention
    "exec": "$HOME/.local/bin/notification-bell",
    "restart-interval": 5,
    "return-type": "json",
    "format": "{text}",
    "escape": true,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "custom/recording": {
    "exec": "$HOME/.local/bin/wf-record status",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "$HOME/.local/bin/wf-record",
    "tooltip": true
  },
  "group/systray": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/tray-expand",
      "tray"
    ]
  },
  "custom/tray-expand": {
    "format": "",
    "tooltip": false
  },
  "tray": {
    "icon-size": 14,
    "spacing": 16
  },
  "cpu": {
    "format": "",
    "on-click": "$TERMINAL --class=btop -e btop"
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click-right": "~/.local/bin/nm-tray toggle",
    "on-click": "nm-connection-editor",
    "interval": 3,
    "nospacing": 1
  },
  "wireplumber#sink": {
    "node-type": "Audio/Sink",
    "format": "{icon}",
    "scroll-step": 5,
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click": "$TERMINAL --class=wiremix -e wiremix --tab output",
    "tooltip-format": "Output: {node_name} ({volume}%)",
    "format-muted": "",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  "wireplumber#source": {
    "node-type": "Audio/Source",
    "scroll-step": 5,
    "format": "",
    "format-muted": "",
    "on-click": "$TERMINAL --class=wiremix -e wiremix --tab input",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "tooltip-format": "Input: {node_name} ({volume}%)"
  },
  "clock": {
    "format": "{:%a %b %d %H:%M}",
    "format-alt": "{:%Y-%m-%d %H:%M}",
    "tooltip": false
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    }
  }
}
