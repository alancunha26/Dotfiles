{
  "schemaVersion": "0.1.0",
  "name": "YouTube",
  "behavior": "create",
  "noteNameFormat": "{{title|safe_name}}",
  "path": "clippings",
  "noteContentFormat": "{% if description %}## Description\n\n{{description}}\n\n{% endif %}{% if transcript %}## Transcript\n\n{{transcript}}{% else %}> No transcript was available when this was clipped.{% endif %}",
  "properties": [
    { "name": "title", "value": "{{title}}", "type": "text" },
    { "name": "author", "value": "{{author}}", "type": "multitext" },
    { "name": "source", "value": "{{url}}", "type": "text" },
    { "name": "date", "value": "{{published|date:\"YYYY-MM-DD\"}}", "type": "date" },
    { "name": "tags", "value": "object/video", "type": "multitext" }
  ],
  "triggers": [
    "https://www.youtube.com/watch",
    "https://www.youtube.com/shorts/"
  ]
}
