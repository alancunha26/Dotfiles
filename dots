#!/usr/bin/env bash
# dots: install and maintain this Arch Linux + Hyprland setup.
#
# The repo describes the machine:
#   Configs/               mirrors $HOME, symlinked into place
#   Extras/packages/*.txt  package lists (repo and AUR), one group per file
#   Extras/system/         files copied into / (Extras/system/etc -> /etc)
#   Extras/migrations/     one-off scripts, each run once per machine
#
# Fresh machine (as your user, from a TTY):
#   bash <(curl -fsSL https://raw.githubusercontent.com/alancunha26/Dotfiles/main/dots) install
#
# Conventions (`dots lint` checks the first three):
#   - apply "..." eval '...' strings use the caller's named locals, never $1 (inside apply, $1 is `eval`).
#   - A function's last statement is never `cond && action`: under set -e it returns 1 when cond is false.
#   - Everything that changes the machine goes through run/srun/apply, so --dry-run only prints it.
#     Read-only checks run in both modes, so a dry run reflects the real state.
#   - Each step runs in a subshell with its own set -e (bash ignores set -e inside `func || ...`), so
#     warn/note write to files in $RUN_DIR and variables set in a step don't survive it. pacman and
#     migrations failures are fatal; other steps fail alone and the run continues.
#   - The ERR trap prints the failing command, so helpers used in < <(...) (orphans, as_deps,
#     pacnew_files, ...) must return 0 when they simply find nothing.
#   - dots holds a lock on fd 9; background jobs must close it (9>&-, see sudo_keepalive).
#   - State lives in ~/.local/state/dots/: backups/<timestamp>/ (anything moved out of the way), logs/
#     (on a TTY, install/update/add/remove/prune re-exec under `script`), migrations/ and lock.
#   - A new install step is a step_<name> function plus entries in STEPS and STEP_TITLES.
# Intentional: eval strings and $ON_ERR are single-quoted so they expand later; "~/" in messages is display text.
# shellcheck disable=SC2016,SC2064,SC2088
set -Eeuo pipefail
shopt -s nullglob dotglob

usage() {
  cat <<'EOF'
Usage: dots <command> [options]

Commands:
  install              Set up everything. Safe to re-run: skips what is already done.
  update               Pull the repo, upgrade the system, then apply everything again.
  status [refresh]     What's new upstream (from the last check, hourly) and how this machine
                       differs from the repo (no root, changes nothing). `refresh` checks now.
  status copy N        Copy command [N] from the status to the clipboard.
  status page          The interactive view (the notification panel's dots card opens it).
  link                 Only (re)create the symlinks from Configs/ into $HOME.
  adopt PATH...        Move files or directories from $HOME into Configs/ and link them back.
  add PKG...           Install packages and record them in a list (default: extras).
  remove PKG...        Uninstall packages and delete them from the lists.
  prune                Uninstall explicitly installed packages that no list mentions.
  new-migration TEXT   Create Extras/migrations/<timestamp>-<text>.sh.
  lint                 Static checks on this repo (no root, changes nothing): bash -n, shellcheck
                       when installed, house rules for dots, Hyprland binds, launchers.

Options:
  -n, --dry-run        Show what would change without changing anything.
  -y, --yes            Don't ask before removing packages.
  -g, --group NAME     List used by 'add' (a file in Extras/packages/, default: extras).
      --groups A,B     Package lists to install (default: all of them).
      --only A,B       Run only these steps of install/update.
      --skip A,B       Skip these steps of install/update.
  -h, --help           Show this help.

Steps, in order: pacman aur migrations link packages system shell runtimes themes apps services
EOF
}

# ── Settings ────────────────────────────────────────────────────────────────

REPO_URL=${DOTS_REPO:-https://github.com/alancunha26/Dotfiles.git}
REPO_PUSH_URL=git@github.com:alancunha26/Dotfiles.git
THEMES_URL=${DOTS_THEMES_REPO:-https://github.com/alancunha26/Themes.git}

# Directories that stay real directories in $HOME, because other programs keep
# their own files in them: their contents are linked one by one. Everything
# else in Configs/ is linked as a whole, so new files there land in the repo.
# .config/thunderbird is Betterbird's profile root; its default/ profile gets user.js and chrome/.
REAL_DIRS=(.config .config/cliamp .config/gtk-4.0 .config/systemd .config/systemd/user .local .local/bin
  .local/share .local/share/applications .claude .claude/skills .config/thunderbird .config/thunderbird/default)

SYSTEM_SERVICES=(NetworkManager.service lactd.service fstrim.timer reflector.timer)
DISPLAY_MANAGER=ly@tty2.service # replaces the getty on the same tty
USER_SERVICES=(waybar.service hyprpolkitagent.service hyprpaper.service hypridle.service dots-check.timer
  protonmail-bridge.service)

ZSH_PLUGINS=(https://github.com/zsh-users/zsh-autosuggestions https://github.com/jeffreytse/zsh-vi-mode)
NPM_GLOBALS=(yarn pnpm short-unique-id)
# asdf plugins that aren't in the asdf plugin index (the rest are added by name)
declare -A ASDF_PLUGIN_URLS=([protonge]=https://github.com/augustobmoura/asdf-protonge.git)

# link comes before packages so ~/.config/pacman/makepkg.conf applies to AUR builds
STEPS=(pacman aur migrations link packages system shell runtimes themes apps services)
declare -A STEP_TITLES=(
  [pacman]="Pacman repositories and system upgrade"
  [aur]="AUR helper"
  [migrations]="Migrations"
  [packages]="Packages"
  [link]="Dotfiles"
  [system]="System files"
  [shell]="Shell"
  [runtimes]="Runtimes (asdf)"
  [themes]="Themes"
  [apps]="Apps"
  [services]="Services"
)

PACMAN_ARGS=(--needed --noconfirm)
YAY_ARGS=(--needed --noconfirm --answerclean None --answerdiff None --answeredit None
  --removemake --cleanafter --sudoloop)

# ── Paths ───────────────────────────────────────────────────────────────────

SELF=$(readlink -f -- "${BASH_SOURCE[0]:-}" 2>/dev/null || true)
DOTFILES=${SELF%/*}
HOME_SRC=$DOTFILES/Configs
PKG_DIR=$DOTFILES/Extras/packages
SYSTEM_SRC=$DOTFILES/Extras/system
MIGRATIONS=$DOTFILES/Extras/migrations
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/dots
STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP=$STATE/backups/$STAMP
CHECK_DIR=$STATE/check

# ── Output ──────────────────────────────────────────────────────────────────

if [[ -t 1 ]]; then
  BOLD=$'\e[1m' DIM=$'\e[2m' RED=$'\e[31m' GREEN=$'\e[32m' YELLOW=$'\e[33m' BLUE=$'\e[34m' RESET=$'\e[0m'
else
  BOLD='' DIM='' RED='' GREEN='' YELLOW='' BLUE='' RESET=''
fi
# Name the command that failed instead of exiting silently under `set -e`.
ON_ERR='printf "  %serror:%s \"%s\" failed (exit %s)\n" "$RED" "$RESET" "$BASH_COMMAND" "$?" >&2'
trap "$ON_ERR" ERR
# Steps run in subshells, so warnings and notes are collected in files.
RUN_DIR=$(mktemp -d)

header() { printf '\n%s==> %s%s\n' "$BLUE$BOLD" "$*" "$RESET"; }
info() { printf '  %s\n' "$*"; }
ok() { printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$*"; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$RESET" "$*" >&2 && printf '%s\n' "$*" >>"$RUN_DIR/warnings"; }
die() { printf '%serror:%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >>"$RUN_DIR/notes"; } # shown at the end: things left for the user to do
wrap() { printf '%s\n' "$*" | fold -s -w 88 | sed 's/^/      /'; }
tilde() { printf '%s' "${1/#"$HOME"/\~}"; }
have() { command -v "$1" &>/dev/null; }
booted() { [[ -d /run/systemd/system ]]; } # false in a chroot/container

# Everything that changes the machine goes through run/srun/apply, so
# --dry-run prints it instead. Read-only checks run normally in both modes.
shell_words() {
  local a q="'" out=()
  for a; do
    if [[ $a =~ ^[][A-Za-z0-9_./:=@%+,~-]+$ ]]; then out+=("$a"); else out+=("'${a//$q/$q\\$q$q}'"); fi
  done
  printf '%s' "${out[*]}"
}
run() {
  if ((DRY_RUN)); then
    printf '  %s[dry-run]%s %s\n' "$DIM" "$RESET" "$(shell_words "$@")"
  else
    "$@"
  fi
}
srun() { run sudo "$@"; }
quiet() { if ((DRY_RUN)); then "$@"; else "$@" >/dev/null; fi; }
# Describe a change, then make it (in --dry-run, only describe it).
apply() {
  local what=$1
  shift
  if ((DRY_RUN)); then
    printf '  %s[dry-run]%s %s\n' "$DIM" "$RESET" "$what"
  else
    printf '  %s+%s %s\n' "$GREEN" "$RESET" "$what"
    "$@"
  fi
}

confirm() {
  ((ASSUME_YES || DRY_RUN)) && return 0
  local reply
  read -rp "  $1 [y/N] " reply </dev/tty || return 1
  [[ $reply == [yY]* ]]
}

# Ask for the password once and keep sudo alive while dots runs.
sudo_keepalive() {
  ((DRY_RUN)) && return 0
  [[ -n ${SUDO_PID:-} ]] && return 0
  sudo -v || die "dots needs sudo"
  # 9>&-: don't hold the dots lock (its `sleep` can outlive dots by a minute)
  while kill -0 $$ 2>/dev/null; do
    sudo -n -v 2>/dev/null || true
    sleep 50
  done 9>&- &
  SUDO_PID=$!
}

# Record the whole run (pacman/yay output included) while keeping it a real TTY.
start_log() {
  ((DRY_RUN)) && return 0
  [[ -n ${DOTS_LOG:-} || ! -t 0 || ! -t 1 ]] && return 0
  have script || return 0
  export DOTS_LOG=$STATE/logs/$STAMP-$CMD.log
  mkdir -p "${DOTS_LOG%/*}"
  SHELL=/bin/bash exec script -qefc "$(printf '%q ' "$SELF" "${ORIG_ARGS[@]}")" "$DOTS_LOG"
}

take_lock() {
  ((DRY_RUN)) && return 0
  mkdir -p "$STATE"
  exec 9>"$STATE/lock"
  flock -n 9 || die "another dots command is already running"
}

# ── Packages ────────────────────────────────────────────────────────────────

csort() { LC_ALL=C sort -u; }
names_in() { (($#)) || return 0; sed 's/#.*//' "$@" | awk 'NF { print $1 }' | csort; }
wanted() { # packages of the selected lists
  local files=() g
  if ((${#SEL_GROUPS[@]})); then
    for g in "${SEL_GROUPS[@]}"; do files+=("$PKG_DIR/$g.txt"); done
  else
    files=("$PKG_DIR"/*.txt)
  fi
  names_in "${files[@]}"
}
listed() { names_in "$PKG_DIR"/*.txt; } # every list: what status/prune compare against
installed() { pacman -Qq | csort; }
explicit() { pacman -Qqe | csort; }
as_deps() { { pacman -Qqd || true; } | csort; }
orphans() { { pacman -Qdttq || true; } | csort; } # -tt keeps packages that are optional deps of others
# reflector rewrites the mirror list weekly, so mirrorlist.pacnew never needs a decision
pacnew_files() { find /etc -name '*.pacnew' ! -path /etc/pacman.d/mirrorlist.pacnew 2>/dev/null || true; }
etc_drift() { # /etc files that differ from Extras/system ($1 = missing|changed|"" for both)
  local src dst
  while IFS= read -r -d '' src; do
    dst=${src#"$SYSTEM_SRC"}
    cmp -s -- "$src" "$dst" 2>/dev/null && continue
    if [[ -e $dst ]]; then [[ ${1:-changed} == changed ]] && echo "$dst"; else [[ ${1:-missing} == missing ]] && echo "$dst"; fi
  done < <(find "$SYSTEM_SRC" -type f -print0 | sort -z)
  return 0
}
pending_migrations() {
  local f
  [[ -d $STATE/migrations ]] || return 0
  for f in "$MIGRATIONS"/*.sh; do [[ -e $STATE/migrations/${f##*/} ]] || echo "${f##*/}"; done
}
missing() { LC_ALL=C comm -23 <(wanted) <(installed); }
unlisted() { LC_ALL=C comm -13 <(listed) <(explicit); }
in_list() { awk -v p="$1" '{ sub(/#.*/, "") } $1 == p { found = 1; exit } END { exit !found }' "$2"; }
record_pkg() { # append "pkg  # description" to a list file
  if [[ -n $2 ]]; then printf '%-28s # %s\n' "$1" "$2" >>"$3"; else printf '%s\n' "$1" >>"$3"; fi
}
unlist_pkg() { # drop package $1 from list file $2, keeping comments and layout
  local tmp
  tmp=$(mktemp)
  awk -v p="$1" '{ l = $0; sub(/#.*/, "", l); split(l, a, " ") } a[1] != p' "$2" >"$tmp" && cat "$tmp" >"$2"
  rm -f "$tmp"
}
list_of() { # which list mentions package $1
  awk -v p="$1" '{ sub(/#.*/, "") } $1 == p { print FILENAME; exit }' "$PKG_DIR"/*.txt
}

aur_names() { # print which of the given names exist in the AUR; fails if it's unreachable
  local q json
  q=$(printf '&arg[]=%s' "$@")
  q=${q//+/%2B}
  json=$(curl -fsS --max-time 30 "https://aur.archlinux.org/rpc/v5/info?${q#&}") || return 1
  grep -o '"Name":"[^"]*"' <<<"$json" | cut -d'"' -f4 || true
}
official_repo() { # repo of an official package, even if that repo isn't enabled here
  curl -fsS --max-time 15 "https://archlinux.org/packages/search/json/?name=$1" |
    grep -o '"repo": *"[^"]*"' | head -1 | cut -d'"' -f4
}

# One line per fact from the package databases (sync = repos, local = installed):
#   N name   |   P name virtual (name provides virtual)   |   D name dependency
pkg_facts() {
  if [[ $1 == sync ]]; then
    local db
    for db in /var/lib/pacman/sync/*.db; do bsdtar -xOf "$db" '*/desc' 2>/dev/null || true; done
  else
    cat /var/lib/pacman/local/*/desc 2>/dev/null || true
  fi | awk '
    /^%NAME%$/ { getline name; print "N", name; next }
    /^%(PROVIDES|DEPENDS)%$/ {
      t = ($0 == "%PROVIDES%") ? "P" : "D"
      # sonames keep their version: libz.so=1-64 and libz.so=1-32 are different things
      while ((getline x) > 0 && x != "") { if (x !~ /\.so=/) sub(/[<>=].*/, "", x); print t, name, x }
    }'
}

# Virtual dependencies (like tessdata, needed by tesseract) with several
# providers where no list names one: with --noconfirm pacman silently takes
# option 1 (tesseract-data-afr). Prints "virtual provider count".
# With packages as arguments, checks what installing them would pull in;
# without, checks what is installed. Soname alternatives (zlib-ng-compat...)
# are drop-in builds of the same library, so they're left out.
default_providers() {
  local tx=$RUN_DIR/transaction conf=/etc/pacman.conf
  [[ -f $RUN_DIR/pacman.conf ]] && conf=$RUN_DIR/pacman.conf # what the pacman step would write (dry run)
  : >"$tx"
  if (($#)) && ! pacman --config "$conf" -Sup --print-format '%n' --noconfirm "$@" >"$tx" 2>"$RUN_DIR/transaction.err"; then
    info "(Couldn't preview the install to check provider choices: $(grep -m1 . "$RUN_DIR/transaction.err" || true))" >&2
    return 0
  fi
  awk -v planned=$(($# > 0)) '
    FILENAME == ARGV[1] { listed[$1] = 1; next }
    FILENAME == ARGV[2] { tx[$1] = 1; next }
    FILENAME == ARGV[3] {
      if ($1 == "N") real[$2] = 1
      else if ($1 == "P" && !(($2, $3) in provides)) { count[$3]++; provides[$2, $3] = 1 }
      else if ($1 == "D" && planned && ($2 in tx)) need[$3] = 1
      next
    }
    $1 == "P" { if (!($3 in have)) have[$3] = $2; provides[$2, $3] = 1 }
    $1 == "D" && !planned { need[$3] = 1 }
    END {
      for (v in need) {
        if (v in real || v ~ /\.so/ || count[v] < 2) continue
        pinned = 0
        for (p in listed) if ((p, v) in provides) { pinned = 1; break }
        if (pinned) continue
        pick = ""
        if (!planned) pick = have[v]
        else if (!(v in have)) for (p in tx) if ((p, v) in provides) pick = p
        if (pick != "") print v, pick, count[v]
      }
    }' <(listed) "$tx" <(pkg_facts sync) <(pkg_facts local)
}

warn_default_providers() { # $@ = packages about to be installed (none: what's installed)
  local virtual pick count
  while read -r virtual pick count; do
    if (($#)); then
      warn "No list picks a provider for '$virtual', so pacman will install option 1 of $count: $pick. Pin the one you want: dots add -g core <provider>"
    else
      warn "pacman picked $pick for '$virtual' (option 1 of $count) because no list names one. Keep it with 'dots add -g core $pick', or swap it: dots add <provider> && dots remove $pick"
    fi
  done < <(default_providers "$@")
}

# Sort packages into REPO_PKGS, AUR_PKGS and UNKNOWN_PKGS.
classify() {
  REPO_PKGS=() AUR_PKGS=() UNKNOWN_PKGS=()
  local p found repo
  local -A in_repos=()
  while read -r p; do in_repos[$p]=1; done < <(pacman -Slq)
  local rest=()
  for p; do
    if [[ -n ${in_repos[$p]:-} ]]; then REPO_PKGS+=("$p"); else rest+=("$p"); fi
  done
  ((${#rest[@]})) || return 0
  if ! found=$(aur_names "${rest[@]}"); then
    warn "Couldn't reach the AUR; treating these as AUR packages: ${rest[*]}"
    AUR_PKGS=("${rest[@]}")
    return 0
  fi
  for p in "${rest[@]}"; do
    if grep -qxF -- "$p" <<<"$found"; then
      AUR_PKGS+=("$p")
    elif repo=$(official_repo "$p") && [[ -n $repo ]]; then
      # e.g. [multilib] before the pacman step enabled it (only happens in --dry-run)
      ((DRY_RUN)) || warn "$p is in [$repo], which isn't enabled in /etc/pacman.conf"
      REPO_PKGS+=("$p")
    else
      UNKNOWN_PKGS+=("$p")
    fi
  done
}

pkg_cmd() { # pacman|yay pkg...
  local tool=$1
  shift
  if [[ $tool == pacman ]]; then
    srun pacman -S "${PACMAN_ARGS[@]}" "$@"
  else
    run yay -S "${YAY_ARGS[@]}" "$@"
  fi
}

# Install in one transaction; if that fails (a conflict, a broken AUR build...),
# retry one package at a time so one bad package doesn't block the others.
install_batch() {
  local tool=$1
  shift
  info "Installing $# package(s) with $tool:"
  wrap "$@"
  pkg_cmd "$tool" "$@" && return 0
  warn "Installing them together failed; retrying one at a time to find the culprit."
  local p failed=()
  for p; do
    pacman -Qq -- "$p" &>/dev/null && continue
    pkg_cmd "$tool" "$p" || failed+=("$p")
  done
  if ((${#failed[@]})); then warn "Failed to install: ${failed[*]}"; fi
}

install_pkgs() {
  (($#)) || return 0
  classify "$@"
  if ((${#UNKNOWN_PKGS[@]})); then
    warn "Not in the repos or the AUR (typo, renamed or removed?), skipped: ${UNKNOWN_PKGS[*]}"
  fi
  if ((${#REPO_PKGS[@]})); then
    warn_default_providers "${REPO_PKGS[@]}"
    install_batch pacman "${REPO_PKGS[@]}"
  fi
  if ((${#AUR_PKGS[@]})); then
    if have yay || ((DRY_RUN)); then
      install_batch yay "${AUR_PKGS[@]}"
    else
      warn "yay isn't installed; skipped AUR packages: ${AUR_PKGS[*]}"
    fi
  fi
}

# Uninstall orphans until none are left (removing some can orphan others).
remove_orphans() {
  local orph confirm_args=()
  ((ASSUME_YES)) && confirm_args=(--noconfirm)
  mapfile -t orph < <(orphans)
  if ((DRY_RUN)); then
    if ((${#orph[@]})); then run sudo pacman -Rns "${orph[@]}"; fi
    return 0
  fi
  while ((${#orph[@]})); do
    sudo pacman -Rns "${confirm_args[@]}" "${orph[@]}" || {
      warn "Orphans were left installed"
      return 0
    }
    mapfile -t orph < <(orphans)
  done
  ok "No orphans left"
}

# ── Links ───────────────────────────────────────────────────────────────────

is_real_dir() {
  local d
  for d in "${REAL_DIRS[@]}"; do [[ $1 == "$d" ]] && return 0; done
  return 1
}

# Move whatever is at $1 (inside $HOME) into this run's backup folder.
backup() {
  local path=$1 rel=${1#"$HOME"/}
  apply "back up ~/$rel -> $(tilde "$BACKUP")/$rel" \
    eval 'mkdir -p -- "$(dirname -- "$BACKUP/$rel")" && mv -- "$path" "$BACKUP/$rel"'
}

ensure_dir() { # make $1 a real directory
  [[ -d $1 && ! -L $1 ]] && return 0
  if [[ -e $1 || -L $1 ]]; then backup "$1"; fi
  apply "create $(tilde "$1")/" mkdir -p -- "$1"
}

ensure_link() { # make $2 a symlink to $1, backing up whatever is in the way
  local src=$1 dst=$2
  [[ -L $dst && $(readlink -- "$dst") == "$src" ]] && return 0
  if [[ -e $dst || -L $dst ]]; then backup "$dst"; fi
  apply "link $(tilde "$dst")" eval 'mkdir -p -- "${dst%/*}" && ln -s -- "$src" "$dst"'
}

link_tree() { # $1 = path inside Configs/ ("" = top level)
  local src rel
  for src in "$HOME_SRC${1:+/$1}"/*; do
    rel=${src#"$HOME_SRC"/}
    if is_real_dir "$rel"; then
      ensure_dir "$HOME/$rel"
      link_tree "$rel"
    else
      ensure_link "$src" "$HOME/$rel"
    fi
  done
}

bad_links() { # print entries of Configs/ that aren't linked into $HOME
  local src rel dst
  for src in "$HOME_SRC${1:+/$1}"/*; do
    rel=${src#"$HOME_SRC"/}
    dst=$HOME/$rel
    if is_real_dir "$rel"; then
      if [[ -d $dst && ! -L $dst ]]; then bad_links "$rel"; else echo "~/$rel (should be a directory)"; fi
    elif ! [[ -L $dst && $(readlink -- "$dst") == "$src" ]]; then
      if [[ -e $dst || -L $dst ]]; then echo "~/$rel (exists, not linked)"; else echo "~/$rel (not linked)"; fi
    fi
  done
}

stale_links() { # broken links into the repo, left behind by files removed from it
  local dir l
  for dir in "$HOME" "${REAL_DIRS[@]/#/$HOME/}"; do
    for l in "$dir"/*; do
      [[ -L $l && ! -e $l && $(readlink -- "$l") == "$DOTFILES"/* ]] && echo "$l"
    done
  done
  return 0
}

make_user_dirs() { # the XDG user dirs from user-dirs.dirs (Documents, Music...)
  local file=$HOME_SRC/.config/user-dirs.dirs line dir re='^XDG_[A-Z]+_DIR="\$HOME/?(.*)"$'
  [[ -f $file ]] || return 0
  while IFS= read -r line; do
    [[ $line =~ $re ]] || continue
    dir=${BASH_REMATCH[1]}
    if [[ -n $dir && ! -d $HOME/$dir ]]; then apply "create ~/$dir/" mkdir -p -- "$HOME/$dir"; fi
  done <"$file"
}

# ── Steps ───────────────────────────────────────────────────────────────────

backup_etc() { [[ -e $1.dots-orig ]] || srun cp -a -- "$1" "$1.dots-orig"; }

step_pacman() {
  local conf=/etc/pacman.conf
  if grep -q '^#\[multilib\]' "$conf"; then
    info "Enabling the [multilib] repository"
    backup_etc "$conf"
    srun sed -i '/^#\[multilib\]$/{s/^#//;n;s/^#//}' "$conf"
  fi
  if grep -q '^\[multilib-testing\]' "$conf" && ! grep -q '^\[core-testing\]' "$conf"; then
    warn "[multilib-testing] is enabled without [core-testing]/[extra-testing]: disabling it (mixing testing and stable repos breaks upgrades)"
    backup_etc "$conf"
    srun sed -i '/^\[multilib-testing\]$/{s/^/#/;n;s/^/#/}' "$conf"
  fi
  if ((DRY_RUN)); then
    sed -e '/^#\[multilib\]$/{s/^#//;n;s/^#//}' "$conf" >"$RUN_DIR/pacman.conf"
    if ! grep -q '^\[core-testing\]' "$conf"; then sed -i '/^\[multilib-testing\]$/{s/^/#/;n;s/^/#/}' "$RUN_DIR/pacman.conf"; fi
  fi
  # Refresh the keyring first so new packager keys don't break the upgrade.
  srun pacman -Sy --needed --noconfirm archlinux-keyring
  srun pacman -Su --noconfirm
}

step_aur() {
  local need=() p tmp
  for p in git base-devel; do pacman -Qq "$p" &>/dev/null || need+=("$p"); done
  if ((${#need[@]})); then srun pacman -S "${PACMAN_ARGS[@]}" "${need[@]}"; fi
  if have yay; then
    ok "yay is installed"
    return 0
  fi
  info "Building yay from the AUR"
  if ((DRY_RUN)); then
    run git clone -q --depth=1 https://aur.archlinux.org/yay.git /tmp/yay
    run makepkg -sr --noconfirm
    run sudo pacman -U --noconfirm "yay-<version>.pkg.tar.zst"
    return 0
  fi
  tmp=$(mktemp -d)
  git clone -q --depth=1 https://aur.archlinux.org/yay.git "$tmp/yay"
  (cd "$tmp/yay" && makepkg -sr --noconfirm) || die "building yay failed"
  # Only the package itself: makepkg also builds yay-debug.
  sudo pacman -U --noconfirm "$tmp"/yay/yay-[0-9]*.pkg.tar.zst
  rm -rf "$tmp"
}

step_migrations() {
  local done_dir=$STATE/migrations f pending=()
  if [[ ! -d $done_dir ]]; then
    # First run on this machine: the lists and configs already describe the
    # end state, so earlier migrations don't apply. Remember them as done.
    apply "create $(tilde "$done_dir")/ (first run)" mkdir -p -- "$done_dir"
    for f in "$MIGRATIONS"/*.sh; do apply "mark ${f##*/} as done" touch "$done_dir/${f##*/}"; done
    return 0
  fi
  for f in "$MIGRATIONS"/*.sh; do [[ -e $done_dir/${f##*/} ]] || pending+=("$f"); done
  if ((${#pending[@]} == 0)); then
    ok "No pending migrations"
    return 0
  fi
  for f in "${pending[@]}"; do
    apply "run migration ${f##*/}" eval \
      '(cd "$DOTFILES" && DOTFILES=$DOTFILES bash -euo pipefail "$f" </dev/null)' ||
      die "Migration ${f##*/} failed. Fix it, then run 'dots update' again."
    ((DRY_RUN)) || touch "$done_dir/${f##*/}"
  done
}

step_packages() {
  local miss deps
  if [[ $MODE == update ]] && have yay; then
    info "Upgrading AUR packages (including -git/nightly ones)"
    run yay -Sua --devel "${YAY_ARGS[@]}"
  fi
  mapfile -t miss < <(missing)
  if ((${#miss[@]})); then
    install_pkgs "${miss[@]}"
  else
    ok "All $(wanted | wc -l) listed packages are installed"
  fi
  # Listed packages installed as dependencies would be removed as orphans once
  # whatever pulled them in goes away; mark them explicit.
  mapfile -t deps < <(LC_ALL=C comm -12 <(wanted) <(as_deps))
  if ((${#deps[@]})); then
    info "Marking ${#deps[@]} listed package(s) as explicitly installed"
    quiet srun pacman -D --asexplicit "${deps[@]}"
  fi
}

step_link() {
  local l bad
  link_tree ""
  while read -r l; do
    apply "remove stale link $(tilde "$l")" rm -- "$l"
  done < <(stale_links)
  make_user_dirs
  ((DRY_RUN)) && return 0
  mapfile -t bad < <(bad_links)
  if ((${#bad[@]})); then
    warn "Not linked: ${bad[*]}"
  else
    ok "Everything in Configs/ is linked into ~"
  fi
}

step_system() {
  local src dst changed=0
  while IFS= read -r -d '' src; do
    dst=${src#"$SYSTEM_SRC"}
    [[ -f $dst ]] && cmp -s -- "$src" "$dst" && continue
    info "Installing $dst"
    if [[ -e $dst ]]; then backup_etc "$dst"; fi
    srun install -Dm644 -- "$src" "$dst"
    changed=1
  done < <(find "$SYSTEM_SRC" -type f -print0 | sort -z)
  if ((!changed)); then
    ok "System files are up to date"
    return 0
  fi
  if booted; then srun systemctl daemon-reload; fi
  ((DRY_RUN)) || note "System files changed (keyboard layout, ...): reboot to apply them"
}

git_sync() { # clone $1 into $2, or pull it when updating
  if [[ ! -d $2/.git ]]; then
    run git clone -q --depth=1 "$1" "$2"
  elif [[ $MODE == update ]]; then
    run git -C "$2" pull -q --ff-only
  else
    ok "$(tilde "$2")"
  fi
}

step_shell() {
  local omz=$HOME/.oh-my-zsh url shell
  git_sync https://github.com/ohmyzsh/ohmyzsh.git "$omz"
  for url in "${ZSH_PLUGINS[@]}"; do git_sync "$url" "$omz/custom/plugins/${url##*/}"; done
  shell=$(getent passwd "$(id -un)" | cut -d: -f7)
  if [[ $shell == /usr/bin/zsh ]]; then
    ok "Login shell is zsh"
  elif have zsh || ((DRY_RUN)); then
    srun chsh -s /usr/bin/zsh "$(id -un)"
    ((DRY_RUN)) || note "Your login shell is now zsh: log out and back in"
  else
    warn "zsh isn't installed; login shell unchanged"
  fi
}

step_runtimes() {
  local asdf_dir=${ASDF_DATA_DIR:-$HOME/.asdf} tool version plugins extra p miss=()
  export PATH=$asdf_dir/shims:$PATH
  # Some plugins (asdf-uv) download into the current directory: use a scratch one.
  cd "$RUN_DIR"
  if ! have asdf; then
    if ((DRY_RUN)); then info "asdf isn't installed yet (the packages step installs it)"; else warn "asdf isn't installed; skipped runtimes"; fi
    return 0
  fi
  plugins=$(asdf plugin list 2>/dev/null || true)
  # fd 3, so commands that read stdin can't eat the rest of the file
  while read -r -u3 tool version _; do
    [[ -z $tool || $tool == '#'* ]] && continue
    if ! grep -qxF -- "$tool" <<<"$plugins"; then
      extra=()
      [[ -n ${ASDF_PLUGIN_URLS[$tool]:-} ]] && extra=("${ASDF_PLUGIN_URLS[$tool]}")
      run asdf plugin add "$tool" "${extra[@]}"
    elif [[ $MODE == update ]]; then
      run asdf plugin update "$tool"
    fi
    if [[ -d $asdf_dir/installs/$tool/$version ]]; then
      ok "$tool $version"
    elif [[ $tool == protonge && ! -e $HOME/.steam/root ]]; then
      note "Proton GE installs into Steam: open Steam once, then run 'dots update'"
    else
      run asdf install "$tool" "$version"
    fi
  done 3<"$HOME_SRC/.tool-versions"

  if ! have npm; then
    info "npm globals (${NPM_GLOBALS[*]}) get installed once node is"
    return 0
  fi
  for p in "${NPM_GLOBALS[@]}"; do npm ls -g --depth=0 "$p" &>/dev/null || miss+=("$p"); done
  if ((${#miss[@]})); then
    run npm install -g "${miss[@]}"
    run asdf reshim nodejs
  else
    ok "npm globals: ${NPM_GLOBALS[*]}"
  fi
}

step_themes() {
  local dir=${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles-themes t gtk
  git_sync "$THEMES_URL" "$dir"
  if [[ ! -d $dir ]]; then
    info "Themes get linked once the repo is cloned"
    return 0
  fi
  for t in "$dir"/tokyo-night/themes/*/; do t=${t%/} && ensure_link "$t" "$HOME/.local/share/themes/${t##*/}"; done
  for t in "$dir"/tokyo-night/icons/*/; do t=${t%/} && ensure_link "$t" "$HOME/.local/share/icons/${t##*/}"; done
  # GTK4/libadwaita apps only read the theme from ~/.config/gtk-4.0. Link through
  # ~/.local/share/themes, like nwg-look does, so the two don't fight over these.
  gtk=$(sed -n 's/^gtk-theme-name=//p' "$HOME_SRC/.config/gtk-4.0/settings.ini")
  for t in assets gtk.css gtk-dark.css; do
    ensure_link "$HOME/.local/share/themes/$gtk/gtk-4.0/$t" "$HOME/.config/gtk-4.0/$t"
  done
}

step_apps() {
  if have claude || [[ -x $HOME/.local/bin/claude ]]; then
    ok "Claude Code"
  else
    apply "install Claude Code (claude.ai/install.sh)" bash -c 'set -o pipefail; curl -fsSL https://claude.ai/install.sh | bash'
  fi

  # No `t3 connect` here: it enables t3code.service, which owns ~/.t3/userdata at
  # boot, and the desktop app then refuses to start because it won't share that home.

  # Betterbird uses the fixed profile ~/.config/thunderbird/default, where link puts user.js and
  # chrome/. A new install only adopts the Default=1 profile if compatibility.ini says an install
  # in the same directory (/opt/betterbird, from betterbird-bin) used it; otherwise it creates a
  # random <id>.default-default and ignores ours. Only on first setup: Betterbird owns these after.
  local tb=$HOME/.config/thunderbird
  if [[ ! -e $tb/profiles.ini ]]; then
    apply "register the Betterbird profile ~/.config/thunderbird/default" eval '
      mkdir -p -- "$tb/default" &&
        printf "[Profile0]\nName=default\nIsRelative=1\nPath=default\nDefault=1\n\n[General]\nStartWithLastProfile=1\nVersion=2\n" >"$tb/profiles.ini" &&
        printf "[Compatibility]\nLastPlatformDir=/opt/betterbird\nLastAppDir=/opt/betterbird\n" >"$tb/default/compatibility.ini"'
  fi

  # fastfetch's logo is the cat sprite as a GIF that kitty plays (night-window@9.gif: one
  # pixel per column of a 9px-wide cell); sprite rebuilds it here when the sprite changed.
  if have magick; then quiet run "$HOME/.local/bin/sprite" gif; fi

  local name what cmd
  while IFS=$'\x1f' read -r name what cmd; do note "$name: $what${cmd:+. Run: $cmd}"; done < <(mail_todo)
}

# Mail accounts can't come from the repo: Bridge keeps its login in the keyring and makes a new
# IMAP password on every login, and Betterbird stores accounts in prefs.js. One line per account
# Betterbird doesn't have yet, "name<US>what to do<US>command" (US = \x1f, so empty fields
# survive `read`): install/update show them as notes, status as rows, the check counts them.
# Bridge's CLI won't start while the service runs, hence the stop/start around it.
mail_todo() {
  local prefs=$HOME/.config/thunderbird/default/prefs.js
  have betterbird || return 0
  grep -qs 'mail\.server\.[^"]*\.hostname", "127\.0\.0\.1"' "$prefs" ||
    printf '%s\x1f%s\x1f%s\n' "Proton Mail" \
      "log in to Bridge ('login', then 'info' for the IMAP password), then add it in Betterbird: IMAP 127.0.0.1:1143, SMTP 127.0.0.1:1025, STARTTLS, accept the certificate" \
      "systemctl --user stop protonmail-bridge && protonmail-bridge-core --cli; systemctl --user start protonmail-bridge"
  grep -qs 'mail\.server\.[^"]*\.hostname", "outlook\.office365\.com"' "$prefs" ||
    printf '%s\x1f%s\x1f%s\n' "Outlook" "turn on IMAP in outlook.com settings, then add the account in Betterbird and sign in with OAuth2" ""
  return 0
}

unit_exists() { # system|user unit
  local unit=$2
  [[ $unit == *@*.* ]] && unit=${unit%%@*}@.${unit##*.} # instance -> template
  [[ -e /usr/lib/systemd/$1/$unit || -e /etc/systemd/$1/$unit ]] ||
    [[ $1 == user && -e $HOME/.config/systemd/user/$unit ]]
}

step_services() {
  local u getty=getty@${DISPLAY_MANAGER#*@}
  for u in "${SYSTEM_SERVICES[@]}" "$DISPLAY_MANAGER"; do
    if ! unit_exists system "$u" && ((DRY_RUN)); then
      run sudo systemctl enable "$u" # its package isn't installed yet
    elif ! unit_exists system "$u"; then
      warn "$u doesn't exist (is its package installed?)"
    elif systemctl is-enabled -q "$u" 2>/dev/null; then
      ok "$u"
    elif [[ $u == *.timer ]] && booted; then
      # --now only starts the timer; run its job once too (e.g. reflector's
      # first refresh) instead of waiting for the first scheduled run
      srun systemctl enable --now "$u"
      srun systemctl start --no-block "${u%.timer}.service"
    elif [[ $u != "$DISPLAY_MANAGER" ]] && booted; then
      srun systemctl enable --now "$u"
    else
      srun systemctl enable "$u"
    fi
  done
  if systemctl is-enabled -q "$getty" 2>/dev/null; then srun systemctl disable "$getty"; fi

  if ! systemctl --user show-environment &>/dev/null; then
    warn "No systemd user session, so user services were skipped. From your own login, run: dots install --only services"
    return 0
  fi
  for u in "${USER_SERVICES[@]}"; do
    if ! unit_exists user "$u" && ((DRY_RUN)); then
      run systemctl --user enable "$u" # its package isn't installed yet
    elif ! unit_exists user "$u"; then
      warn "$u doesn't exist (is its package installed?)"
    elif systemctl --user is-enabled -q "$u" 2>/dev/null; then
      ok "$u (user)"
    elif [[ $u == *.timer || $u == protonmail-bridge.service ]]; then
      # The others need the graphical session; Bridge only needs the keyring, so start it now.
      run systemctl --user enable --now "$u"
    else
      run systemctl --user enable "$u"
    fi
  done
}

# ── Update check ────────────────────────────────────────────────────────────
#
# `dots check` collects what `dots update` would bring in, plus what needs a
# decision, without root and without changing anything. The result is cached
# in $CHECK_DIR for the notification panel (a "dots" card, see check_notify), the
# waybar bell (~/.local/bin/notification-bell) and the page (`dots status page`); a
# user timer (dots-check.timer, in Configs/.config/systemd/user, hence that path in
# REAL_DIRS) refreshes it hourly. The bell counts the card as one notification and goes
# yellow/red for attention/errors; the Updates tile is lit while anything is pending.
# The page runs in a floating kitty (class dots-check). The network checks run in parallel.

# Tokyo Night colors for the report (truecolor; the page runs in kitty)
T_HEAD=$'\e[1;38;2;130;170;255m' T_SEC=$'\e[38;2;192;153;255m' T_NEW=$'\e[38;2;195;232;141m'
T_WARN=$'\e[38;2;255;199;119m' T_ERR=$'\e[38;2;255;117;127m' T_DIM=$'\e[38;2;99;109;166m' T_OFF=$'\e[0m'
T_BLUE=$'\e[38;2;130;170;255m' T_CYAN=$'\e[38;2;134;225;252m' T_TEXT=$'\e[1;38;2;200;211;245m'

check_repos() { # "name<TAB>dir" for every other git repo `dots update` pulls
  local d
  printf '%s\t%s\n' "Oh My Zsh" "$HOME/.oh-my-zsh"
  for d in "$HOME/.oh-my-zsh/custom/plugins"/*/; do printf '%s\t%s\n' "zsh: $(basename "$d")" "${d%/}"; done
  for d in "${ASDF_DATA_DIR:-$HOME/.asdf}/plugins"/*/; do printf '%s\t%s\n' "asdf: $(basename "$d")" "${d%/}"; done
  printf '%s\t%s\n' "Themes" "${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles-themes"
}

fetch_quietly() { timeout 60 env GIT_SSH_COMMAND='ssh -o BatchMode=yes' git -C "$1" fetch -q &>/dev/null; }
incoming() { git -C "$1" log --format='%h %s' 'HEAD..@{u}' 2>/dev/null || true; }

# Gather everything into $CHECK_DIR: summary (the counts the bell, the card and the page
# read), upstream (status rows, see draw_section) and packages ("name<TAB>old<TAB>new").
check_collect() {
  local updates=0 attention=0 rc line name dir lines=() failed=() rows others=0
  mkdir -p "$CHECK_DIR"
  exec 8>"$CHECK_DIR/lock"
  flock -w 600 8 || return 0 # another check is running; its result will do
  rows=$(mktemp)
  r() { local IFS=$'\x1f'; printf '%s\n' "$*" >>"$rows"; } # kind state label text

  # The network checks don't depend on each other: run them all at once, each
  # writing its result into $work, and wait for the slowest.
  local work pids=() i=0
  work=$(mktemp -d)
  { if fetch_quietly "$DOTFILES"; then echo ok; else echo fail; fi; } >"$work/dotfiles" &
  pids+=($!)
  { timeout 180 checkupdates >"$work/repo" 2>/dev/null && echo 0 || echo $?; } >"$work/repo.rc" &
  pids+=($!)
  if have yay; then
    { timeout 600 yay -Qua --devel 2>/dev/null || true; } >"$work/aur" &
    pids+=($!)
  fi
  while IFS=$'\t' read -r name dir; do
    [[ -d $dir/.git ]] || continue
    i=$((i + 1))
    printf '%s\t%s\t%s\n' "$i" "$name" "$dir" >>"$work/repos"
    { if fetch_quietly "$dir"; then echo ok; else echo fail; fi; } >"$work/repo-$i" &
    pids+=($!)
  done < <(check_repos)
  wait "${pids[@]}" 2>/dev/null || true

  if [[ $(<"$work/dotfiles") != ok ]]; then
    r row err Dotfiles "couldn't fetch the repo"
    failed+=(dotfiles)
  else
    mapfile -t lines < <(incoming "$DOTFILES")
    if ((${#lines[@]})); then
      r row new Dotfiles "$(plural ${#lines[@]} "new commit")"
      for line in "${lines[@]:0:5}"; do r sub "" "${line%% *}" "${line#* }"; done
      if ((${#lines[@]} > 5)); then r sub "" "" "… $((${#lines[@]} - 5)) more"; fi
      updates=$((updates + ${#lines[@]}))
    else
      r row ok Dotfiles "up to date"
    fi
  fi

  # Packages: repo (checkupdates: 0 = updates, 2 = none) and AUR, -git/nightly included
  local repo_pkgs=() aur_pkgs=()
  rc=$(<"$work/repo.rc")
  if ((rc == 0)); then mapfile -t repo_pkgs <"$work/repo"; fi
  if [[ -s $work/aur ]]; then mapfile -t aur_pkgs <"$work/aur"; fi
  : >"$CHECK_DIR/packages.tmp"
  for line in "${repo_pkgs[@]}" "${aur_pkgs[@]}"; do
    read -r name old _ new <<<"$line"
    printf '%s\t%s\t%s\n' "$name" "$old" "$new" >>"$CHECK_DIR/packages.tmp"
  done
  if ((rc != 0 && rc != 2)); then
    r row err Packages "couldn't check the package repos"
    failed+=(packages)
  elif ((${#repo_pkgs[@]} + ${#aur_pkgs[@]})); then
    r row new Packages "${#repo_pkgs[@]} repo · ${#aur_pkgs[@]} AUR"
    updates=$((updates + ${#repo_pkgs[@]} + ${#aur_pkgs[@]}))
  else
    r row ok Packages "up to date"
  fi

  # The other repos `dots update` pulls: just their new commits
  while IFS=$'\t' read -r i name dir; do
    if [[ $(<"$work/repo-$i") != ok ]]; then
      r row err "$name" "couldn't fetch"
      failed+=("$name")
      continue
    fi
    mapfile -t lines < <(incoming "$dir")
    ((${#lines[@]})) || continue
    others=$((others + 1))
    r row new "$name" "$(plural ${#lines[@]} "new commit")"
    for line in "${lines[@]:0:3}"; do r sub "" "${line%% *}" "${line#* }"; done
    if ((${#lines[@]} > 3)); then r sub "" "" "… $((${#lines[@]} - 3)) more"; fi
    updates=$((updates + 1))
  done < <(cat "$work/repos" 2>/dev/null)
  if ((others == 0)); then r row ok "Other repos" "up to date"; fi
  rm -rf "$work"

  # Local state `dots update` will settle on its own
  local miss migr stale etc_new
  mapfile -t miss < <(missing)
  mapfile -t etc_new < <(etc_drift missing)
  mapfile -t migr < <(pending_migrations)
  mapfile -t stale < <(stale_links)
  updates=$((updates + ${#miss[@]} + ${#migr[@]} + ${#stale[@]} + ${#etc_new[@]}))

  # Things that need a decision: `dots update` alone won't resolve them
  local unl orph prov bad drift pacnew mail
  mapfile -t unl < <(unlisted)
  mapfile -t orph < <(orphans)
  mapfile -t prov < <(default_providers | awk '{ print $1 " -> " $2 }')
  mapfile -t bad < <(bad_links)
  mapfile -t drift < <(etc_drift changed)
  mapfile -t pacnew < <(pacnew_files)
  mapfile -t mail < <(mail_todo)
  attention=$((${#unl[@]} + ${#orph[@]} + ${#prov[@]} + ${#bad[@]} + ${#drift[@]} + ${#pacnew[@]} + ${#mail[@]}))

  mv -f "$rows" "$CHECK_DIR/upstream"
  mv -f "$CHECK_DIR/packages.tmp" "$CHECK_DIR/packages"
  rm -f "$CHECK_DIR/report"
  printf 'updates=%d\nattention=%d\nerrors=%d\nchecked=%d\nprunable=%d\npacnew=%d\nunlinked=%d\n' \
    "$updates" "$attention" "${#failed[@]}" "$(date +%s)" $((${#unl[@]} + ${#orph[@]})) "${#pacnew[@]}" "${#bad[@]}" \
    >"$CHECK_DIR/summary.tmp"
  mv -f "$CHECK_DIR/summary.tmp" "$CHECK_DIR/summary"
  check_notify
}

check_summary() { # load the cached summary (zeros when there is none)
  updates=0 attention=0 errors=0 checked=0 prunable=0 pacnew=0 unlinked=0
  [[ -f $CHECK_DIR/summary ]] || return 0
  # shellcheck disable=SC1091
  source "$CHECK_DIR/summary"
}

# "rows cols" of the terminal, read from /dev/tty because these run inside pipes and $(...)
term_size() { { stty size </dev/tty; } 2>/dev/null || echo 24 100; }

# This machine against the repo, as status rows (see draw_section); computed live, not cached.
machine_rows() {
  local miss unl orph prov bad stale etc_new drift pacnew migr mail state name what cmd parts
  r() { local IFS=$'\x1f'; printf '%s\n' "$*"; } # kind state label text
  mapfile -t miss < <(missing)
  mapfile -t unl < <(unlisted)
  mapfile -t orph < <(orphans)
  mapfile -t prov < <(default_providers | awk '{ print $1 " -> " $2 }')
  mapfile -t bad < <(bad_links)
  mapfile -t stale < <(stale_links)
  mapfile -t etc_new < <(etc_drift missing)
  mapfile -t drift < <(etc_drift changed)
  mapfile -t pacnew < <(pacnew_files)
  mapfile -t mail < <(mail_todo)

  parts="$(listed | wc -l) listed"
  if ((${#miss[@]} + ${#unl[@]} + ${#orph[@]} + ${#prov[@]} == 0)); then
    r row ok Packages "$parts · none unlisted · no orphans"
  else
    state=new
    if ((${#unl[@]} + ${#orph[@]} + ${#prov[@]})); then state=warn; fi
    r row "$state" Packages "$parts"
    if ((${#miss[@]})); then
      r sub "" "not installed" "${miss[*]}"
      r cmd "" "" "dots update"
    fi
    if ((${#unl[@]})); then
      r sub "" "in no list" "${unl[*]}"
      r cmd "" "" "dots add -g extras ${unl[*]}"
      r cmd "" "" "dots prune"
    fi
    if ((${#orph[@]})); then
      r sub "" "orphans" "${orph[*]}"
      r cmd "" "" "dots prune"
    fi
    if ((${#prov[@]})); then r sub "" "providers" "pacman picked ${prov[*]}; pin the one you want with dots add"; fi
  fi

  if ((${#bad[@]} + ${#stale[@]} == 0)); then
    r row ok Links "all in place"
  else
    r row warn Links "${#bad[@]} not linked · ${#stale[@]} stale"
    for name in "${bad[@]}"; do r sub "" "" "$name"; done
    if ((${#stale[@]})); then r sub "" "stale" "${stale[*]/#$HOME/\~}"; fi
    r cmd "" "" "dots link"
  fi

  if ((${#etc_new[@]} + ${#drift[@]} + ${#pacnew[@]} == 0)); then
    r row ok "System files" "match Extras/system · no .pacnew"
  else
    state=new
    if ((${#drift[@]} + ${#pacnew[@]})); then state=warn; fi
    r row "$state" "System files" "${#etc_new[@]} to install · ${#drift[@]} differ · ${#pacnew[@]} .pacnew"
    if ((${#etc_new[@]})); then
      r sub "" "to install" "${etc_new[*]}"
      r cmd "" "" "dots update"
    fi
    if ((${#drift[@]})); then r sub "" "differ" "${drift[*]}"; fi
    if ((${#pacnew[@]})); then
      r sub "" ".pacnew" "${pacnew[*]}"
      r cmd "" "" "sudo DIFFPROG='nvim -d' pacdiff"
    fi
  fi

  if [[ ! -d $STATE/migrations ]]; then
    r row new Migrations "dots hasn't run on this machine yet"
    r cmd "" "" "dots install"
  else
    mapfile -t migr < <(pending_migrations)
    if ((${#migr[@]})); then
      r row new Migrations "${#migr[@]} pending"
      r sub "" "" "${migr[*]}"
      r cmd "" "" "dots update"
    else
      r row ok Migrations "none pending"
    fi
  fi

  if ! have betterbird; then return 0; fi
  if ((${#mail[@]} == 0)); then
    r row ok Mail "accounts set up"
    return 0
  fi
  r row warn Mail "$(plural ${#mail[@]} account) not set up"
  for name in "${mail[@]}"; do
    IFS=$'\x1f' read -r name what cmd <<<"$name"
    r sub "" "$name" "$what"
    if [[ -n $cmd ]]; then r cmd "" "" "$cmd"; fi
  done
}

# Terminal output house style (CLAUDE.md, "Terminal output"): a section is a dim box rule with
# its title, rows "│ ├ ✓ Label  text" with the tree drawn in the row's state color (ok green,
# new blue, warn yellow, err red) and the last row on "└ └", sub rows hanging under their row,
# and commands numbered for `dots status copy N`. Everything wraps at the box width itself, so
# nothing relies on the terminal wrapping or cutting lines (less cuts them under --header).
repeat() { local s; printf -v s '%*s' "$2" ''; printf '%s' "${s// /$1}"; }
plural() { if (($1 == 1)); then printf '%s %s' "$1" "$2"; else printf '%s %s' "$1" "${3:-${2}s}"; fi; } # N one [many]

wrap() { # print $2 in lines of at most $1 characters, broken at spaces
  local w=$1 word line="" words
  ((w < 8)) && w=8
  read -ra words <<<"$2"
  for word in "${words[@]}"; do
    while ((${#word} > w)); do
      if [[ -n $line ]]; then printf '%s\n' "$line" && line=""; fi
      printf '%s\n' "${word:0:w}"
      word=${word:w}
    done
    if [[ -z $line ]]; then
      line=$word
    elif ((${#line} + 1 + ${#word} <= w)); then
      line+=" $word"
    else
      printf '%s\n' "$line"
      line=$word
    fi
  done
  printf '%s\n' "$line"
}

rule() { # a section heading: the title, then a dim line to the box width
  local t=$1
  if ((${#t} > BW - 6)); then t="${t:0:$((BW - 7))}…"; fi
  OUT+=" $T_SEC$t$T_OFF $T_DIM$(repeat ─ $((BW - ${#t} - 2)))$T_OFF"$'\n'
}

lines_out() { # $1 = first prefix, $2 = following prefix, $3 = prefix width, $4 = color, $5 = text
  local first=1 line
  while IFS= read -r line; do
    if ((first)); then OUT+="$1$4$line$T_OFF"$'\n'; else OUT+="$2$4$line$T_OFF"$'\n'; fi
    first=0
  done < <(wrap $((BW - $3 < 90 ? BW - $3 : 90)) "$5") # prose stays at a readable width
}

draw_section() { # $1 = title, $2 = rows ("kind<US>state<US>label<US>text", kind row|sub|cmd)
  local rows kind state label text i last=-1 c glyph tc trunk branch cont pad lw=0 sw=0 col
  mapfile -t rows <<<"$2"
  for i in "${!rows[@]}"; do
    IFS=$'\x1f' read -r kind state label text <<<"${rows[i]}"
    if [[ $kind == row ]]; then
      last=$i
      if ((${#label} > lw)); then lw=${#label}; fi
    elif [[ $kind == sub ]] && ((${#label} > sw)); then
      sw=${#label}
    fi
  done
  # Labels get their longest width plus 2 spaces; row and sub-row text share one column.
  if ((lw > 18)); then lw=18; fi
  if ((sw > 16)); then sw=16; fi
  col=$((5 + lw + 2))
  if ((sw && 7 + sw + 2 > col)); then col=$((7 + sw + 2)); fi
  rule "$1"
  for i in "${!rows[@]}"; do
    IFS=$'\x1f' read -r kind state label text <<<"${rows[i]}"
    case $kind in
      row)
        case $state in
          ok) c=$T_NEW glyph=✓ tc="" ;;
          new) c=$T_BLUE glyph=↓ tc="" ;;
          err) c=$T_ERR glyph=✗ tc=$T_ERR ;;
          *) c=$T_WARN glyph=! tc=$T_WARN ;;
        esac
        if ((i == last)); then branch="└" trunk="     " cont=" "; else branch="├" trunk=" $T_DIM│$T_OFF   " cont="$T_DIM│$T_OFF"; fi
        printf -v pad '%-*s' $((col - 5)) "${label:0:lw}"
        lines_out " $T_DIM$branch$T_OFF $c$glyph$T_OFF $pad" " $cont$(repeat ' ' $((col - 2)))" "$col" "$tc" "$text"
        ;;
      sub | cmd)
        if [[ ${rows[i + 1]:-row$'\x1f'} == row$'\x1f'* ]]; then branch="└ " cont="  "; else branch="├ " cont="│ "; fi
        if [[ $kind == cmd ]]; then
          CMDS+=("$text")
          printf -v pad '[%d] $ ' "${#CMDS[@]}"
          lines_out "$trunk$T_DIM$branch$pad$T_OFF" "$trunk$T_DIM$cont$T_OFF$(repeat ' ' ${#pad})" $((7 + ${#pad})) "$T_CYAN" "$text"
        elif [[ -n $label ]]; then
          printf -v pad '%-*s' $((col - 7)) "${label:0:sw}"
          lines_out "$trunk$T_DIM$branch$T_OFF$pad" "$trunk$T_DIM$cont$T_OFF$(repeat ' ' $((col - 7)))" "$col" "" "$text"
        else
          lines_out "$trunk$T_DIM$branch$T_OFF" "$trunk$T_DIM$cont$T_OFF" 7 "$T_DIM" "$text"
        fi
        # a row that opened sub rows gets a spacer before the next row
        if [[ $branch == "└ " && ${trunk} != "     " ]]; then OUT+=" $T_DIM│$T_OFF"$'\n'; fi
        ;;
    esac
  done
}

# The whole status for a terminal $1 columns wide, with colors (callers strip them when not on
# a terminal); fills CMDS with its numbered commands. Upstream comes from the last check (the
# hourly timer, `dots status refresh`), this machine is read now.
status_render() {
  local updates attention errors checked prunable pacnew unlinked left right age OUT="" BW
  BW=$(($1 < 160 ? $1 : 160))
  ((BW < 30)) && BW=30
  CMDS=()
  check_summary
  if ((updates + attention == 0)); then left="all up to date"; else left="$(plural "$updates" update) · $(plural "$attention" "needs you" "need you")"; fi
  if ((errors)); then left+=" · couldn't check everything"; fi
  age=$((($(date +%s) - checked) / 60))
  if ((checked == 0)); then right="${HOSTNAME:-} · not checked yet"; else right="${HOSTNAME:-} · checked $age min ago"; fi
  if ((8 + ${#left} + 2 + ${#right} <= BW)); then
    OUT+="$T_HEAD dots$T_OFF$T_DIM · $T_OFF$T_TEXT$left$T_OFF$(repeat ' ' $((BW - 8 - ${#left} - ${#right})))$T_DIM$right$T_OFF"$'\n\n'
  else
    OUT+="$T_HEAD dots$T_OFF$T_DIM · $T_OFF$T_TEXT${left:0:$((BW - 8))}$T_OFF"$'\n\n'
  fi
  if [[ -s $CHECK_DIR/upstream ]]; then
    draw_section Upstream "$(<"$CHECK_DIR/upstream")"
  else
    draw_section Upstream "row"$'\x1f'"new"$'\x1f'"Upstream"$'\x1f'"not checked yet"$'\n'"cmd"$'\x1f\x1f\x1f'"dots status refresh"
  fi
  OUT+=$'\n'
  draw_section "This machine" "$(machine_rows)"
  if [[ -s $CHECK_DIR/packages ]]; then
    OUT+=$'\n'
    rule "Package updates · $(wc -l <"$CHECK_DIR/packages")"
    OUT+="$(check_columns "$BW" <"$CHECK_DIR/packages")"$'\n'
  fi
  printf '%s' "$OUT"
}

# Package lines in the report are "  name<TAB>old<TAB>new" (yay reports -git packages as
# "latest-commit [age]"). Lay them out in as many columns as fit $1 characters, like ls: top
# to bottom, then across, each column only as wide as its longest entry. Versions are cut to
# 16 characters (glibc's run to 24 and would leave room for one column) and names to 26 (a few
# lib32-vulkan-* would widen every column). Other lines pass through.
check_columns() {
  awk -F'\t' -v width="$1" -v dim="$T_DIM" -v hi="$T_NEW" -v warn="$T_WARN" -v off="$T_OFF" '
    function cut(v) { return length(v) > 16 ? substr(v, 1, 15) "…" : v }
    function fits(c,   j, i, rows, tot, rest) {
      rows = int((n + c - 1) / c)
      tot = 2 + 6 * (c - 1)
      for (j = 1; j <= c; j++) {
        nw[j] = ow[j] = vw[j] = 0
        git[j] = 0
        for (i = (j - 1) * rows + 1; i <= j * rows && i <= n; i++) {
          if (length(name[i]) > nw[j]) nw[j] = length(name[i])
          if (git_[i]) { git[j] = 1; continue }
          if (length(old[i]) > ow[j]) ow[j] = length(old[i])
          if (length(new[i]) > vw[j]) vw[j] = length(new[i])
        }
        rest = ow[j] + vw[j] ? ow[j] + 3 + vw[j] : 0
        if (git[j] && rest < 11) rest = 11
        cw[j] = nw[j] + 2 + rest
        tot += cw[j]
      }
      return tot <= width
    }
    function flush(   c, rows, r, j, i, line, cell, vis) {
      if (!n) return
      for (c = int(width / 12); c > 1; c--) if (c <= n && fits(c)) break
      dropold = 0
      if (!fits(c)) {
        nw[1] = width - 2 - 2 - (ow[1] ? ow[1] + 3 : 0) - vw[1]
        if (nw[1] < 10) { dropold = 1; nw[1] = width - 2 - 2 - vw[1] }
        if (nw[1] < 4) nw[1] = 4
        for (i = 1; i <= n; i++) if (length(name[i]) > nw[1]) name[i] = substr(name[i], 1, nw[1] - 1) "…"
      }
      rows = int((n + c - 1) / c)
      for (r = 1; r <= rows; r++) {
        line = " "
        for (j = 1; j <= c; j++) {
          i = (j - 1) * rows + r
          if (i > n) break
          if (git_[i]) {
            cell = sprintf("%-*s  %s", nw[j], name[i], warn "new commits" off)
            vis = nw[j] + 13
          } else {
            if (dropold) {
              cell = sprintf("%-*s  %s", nw[j], name[i], hi new[i] off)
              vis = nw[j] + 2 + length(new[i])
            } else {
              cell = sprintf("%-*s  %*s %s→%s %s", nw[j], name[i], ow[j], old[i], dim, off, hi new[i] off)
              vis = nw[j] + 2 + ow[j] + 3 + length(new[i])
            }
          }
          line = line " " cell
          if (j < c && i + rows <= n) line = line sprintf("%*s", cw[j] - vis + 5, "")
        }
        print line
      }
      n = 0
    }
    NF == 3 { sub(/^ +/, "", $1); name[++n] = length($1) > 26 ? substr($1, 1, 25) "…" : $1; git_[n] = $3 ~ /^latest-commit/; old[n] = cut($2); new[n] = cut($3); next }
    { flush(); print }
    END { flush() }'
}

# The "dots" card in the notification panel: one notification that every check replaces
# (its id is in $CHECK_DIR/notify-id), closed only when there's nothing left to do. swaync
# keeps it out of the pop-ups and opens the page when it's clicked (swaync/config.json).
# The waybar bell (~/.local/bin/notification-bell) leaves it out of its count and runs
# `dots check card` to put it back when it's closed and back on top when something new
# arrives (re-posting makes it the newest; swaync sorts by time).
check_notify() {
  local updates attention errors checked prunable pacnew unlinked id="" title body
  have notify-send || return 0
  check_summary
  [[ -f $CHECK_DIR/notify-id ]] && id=$(<"$CHECK_DIR/notify-id")
  if ((updates + attention + errors == 0)); then
    # forget the id first: the bell puts back a closed card whose id is still there
    rm -f "$CHECK_DIR/notify-id"
    if [[ -n $id ]]; then
      gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.CloseNotification "$id" &>/dev/null || true
    fi
    return 0
  fi
  title="$updates update(s), $attention to look at"
  if ((errors)); then title+=", couldn't check everything"; fi
  # One line per upstream row with news ("Packages: 3 repo · 1 AUR, listed below"), then the rest
  body=$(awk -F'\x1f' '$1 == "row" && $2 != "ok" { print $3 ": " $4 }' "$CHECK_DIR/upstream" 2>/dev/null)
  if ((attention)); then body+="${body:+$'\n'}This machine: $(plural "$attention" "thing needs" "things need") you (dots status)"; fi
  id=$(notify-send -a dots -u low -i system-software-update -p ${id:+-r "$id"} "$title" "$body" 2>/dev/null) || return 0
  if [[ -n $id ]]; then printf '%s\n' "$id" >"$CHECK_DIR/notify-id"; fi
  return 0
}

# The page is less over status_render: the header stays pinned (--header), the report scrolls
# and searches, and each action key quits less with that key as its exit status (lesskey's
# "quit <char>"), so the loop runs the action and opens the page again. less can't redraw
# itself, so every check (on opening, r, after an action) runs before less, with the pixel-art
# cat (~/.local/bin/sprite play) playing meanwhile. c lists the numbered commands to copy one.
check_page() { # the floating window behind the panel's dots card and the Updates tile
  local rc key keys prompt page=$RUN_DIR/page rows cols CMDS=() updates attention errors checked prunable pacnew unlinked

  recheck() {
    "$DOTFILES/Configs/.local/bin/sprite" play -m "checking for updates" "$SELF" check quiet || true
  }

  run_action() { # run it, wait for a key, then check again
    clear
    "$@" || true
    printf '\nPress a key to go back '
    read -rsn1 _ || true
    recheck
  }

  copy_command() {
    local n
    clear
    for n in "${!CMDS[@]}"; do printf '  %s[%d]%s %s\n' "$T_DIM" $((n + 1)) "$T_OFF" "${CMDS[n]}"; done
    printf '\nCopy which command? [1-%d, Enter to go back] ' "${#CMDS[@]}"
    read -r n || return 0
    if [[ $n =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#CMDS[@]})); then
      printf '%s' "${CMDS[n - 1]}" | wl-copy
      printf '%sCopied.%s' "$T_NEW" "$T_OFF"
      read -rsn1 -t 1 _ || true
    fi
  }

  recheck
  while true; do
    read -r rows cols < <(term_size)
    status_render "$cols" >"$page"
    check_summary # only offer the actions that have something to do
    keys='#command\n' prompt=''
    if ((updates)); then keys+='u quit u\n' prompt+='u update · '; fi
    if ((prunable)); then keys+='p quit p\n' prompt+='p prune · '; fi
    if ((pacnew)); then keys+='m quit m\n' prompt+='m merge \.pacnew · '; fi
    if ((unlinked)); then keys+='l quit l\n' prompt+='l link · '; fi
    if ((${#CMDS[@]})); then keys+='c quit c\n' prompt+='c copy a command · '; fi
    keys+='r quit r\n' prompt+='r check again · q close'
    rc=0
    less -R --use-color --color=P60 --header=2 --mouse --tilde --lesskey-content="$(printf '%b' "$keys")" --prompt="$prompt" "$page" || rc=$?
    ((rc)) || exit 0
    printf -v key "\\$(printf '%03o' "$rc")"
    case $key in
      u) run_action "$SELF" update ;;
      p) run_action "$SELF" prune ;;
      m) run_action sudo DIFFPROG='nvim -d' pacdiff ;;
      l) run_action "$SELF" link ;;
      c) copy_command ;;
      r) recheck ;;
      *) exit 0 ;;
    esac
  done
}

cmd_check() { # plumbing: the hourly timer runs `quiet`, the waybar bell runs `card`
  case ${1:-} in
    quiet) check_collect ;;
    card) check_notify ;; # re-post the panel card from the last check
    *) die "usage: dots check quiet|card (see dots status)" ;;
  esac
}

# ── Commands ────────────────────────────────────────────────────────────────

pull_repo() {
  [[ -n ${DOTS_PULLED:-} ]] && return 0
  header "Dotfiles repo"
  local before
  before=$(git -C "$DOTFILES" rev-parse HEAD)
  if ((DRY_RUN)); then
    run git -C "$DOTFILES" pull --ff-only --autostash
    return 0
  fi
  git -C "$DOTFILES" pull --ff-only --autostash || die "git pull failed; sort it out in $DOTFILES and run again"
  if [[ $(git -C "$DOTFILES" rev-parse HEAD) != "$before" ]]; then
    info "The repo changed; restarting with the new version of dots"
    DOTS_PULLED=1 exec "$SELF" "${ORIG_ARGS[@]}"
  fi
}

want_step() {
  local x
  if ((${#ONLY[@]})); then
    for x in "${ONLY[@]}"; do [[ $x == "$1" ]] && return 0; done
    return 1
  fi
  for x in "${SKIP[@]}"; do [[ $x == "$1" ]] && return 1; done
  return 0
}

cmd_install() { # install and update
  [[ -f /etc/arch-release ]] || die "dots only supports Arch Linux"
  ((EUID)) || die "run dots as your user, not root (it uses sudo when it needs to)"
  MODE=$CMD
  ((DRY_RUN)) && printf '%sDry run:%s nothing will be changed.\n' "$BOLD" "$RESET"
  [[ $MODE == update ]] && pull_repo
  sudo_keepalive
  local s rc
  for s in "${STEPS[@]}"; do
    want_step "$s" || continue
    header "${STEP_TITLES[$s]}"
    # A subshell with its own `set -e`: a failure stops this step, not the ones
    # after it (bash would silently ignore `set -e` inside `step_x || ...`).
    trap - ERR && set +e
    (trap "$ON_ERR" ERR; set -e; "step_$s")
    rc=$?
    set -e && trap "$ON_ERR" ERR
    ((rc == 0)) && continue
    # Going on after a failed upgrade risks a partial upgrade; after a failed
    # migration, later steps may assume it ran.
    [[ $s == pacman || $s == migrations ]] && die "The $s step failed, so dots stopped. Fix the cause and run it again."
    warn "The $s step failed. Once the cause is fixed: dots $MODE --only $s"
  done
  summary
}

summary() {
  local miss unl orph pacnew line
  header "Summary"
  # First what came up during this run, then the state of the machine.
  if [[ -f $RUN_DIR/warnings ]]; then
    while IFS= read -r line; do printf '  %s!%s %s\n' "$YELLOW" "$RESET" "$line"; done <"$RUN_DIR/warnings"
  fi
  mapfile -t miss < <(missing)
  mapfile -t unl < <(unlisted)
  mapfile -t orph < <(orphans)
  mapfile -t pacnew < <(pacnew_files)
  if ((DRY_RUN)); then
    info "Dry run: nothing was changed."
  elif ((${#miss[@]})) && want_step packages; then
    printf '  %s!%s %s\n' "$YELLOW" "$RESET" "${#miss[@]} listed package(s) aren't installed: ${miss[*]}"
  elif ((${#miss[@]})); then
    info "${#miss[@]} listed package(s) aren't installed yet (the packages step didn't run)"
  else
    ok "All listed packages are installed"
  fi
  if ((${#unl[@]})); then info "${#unl[@]} installed package(s) aren't in any list: see 'dots status', then 'dots add' or 'dots prune'"; fi
  if ((${#orph[@]})); then info "${#orph[@]} orphaned package(s): 'dots prune' removes them"; fi
  if ((${#pacnew[@]})); then info "${#pacnew[@]} .pacnew file(s) in /etc: merge them with: sudo DIFFPROG='nvim -d' pacdiff"; fi
  ((DRY_RUN)) || warn_default_providers
  if [[ -d $BACKUP ]]; then info "Files that were in the way are in $(tilde "$BACKUP")"; fi
  if [[ -f $RUN_DIR/notes ]]; then
    while IFS= read -r line; do printf '  %s→%s %s\n' "$BLUE" "$RESET" "$line"; done < <(sort -u "$RUN_DIR/notes")
  fi
  if [[ -n ${DOTS_LOG:-} ]]; then info "Log: $(tilde "$DOTS_LOG")"; fi
}

show_list() { # title, then items
  local title=$1
  shift
  if (($#)); then
    printf '  %s%s (%d):%s\n' "$BOLD" "$title" $# "$RESET"
    if [[ $* == *' ('* ]]; then printf '      %s\n' "$@"; else wrap "$@"; fi
  else
    ok "$title: none"
  fi
}

cmd_status() { # $1 = "" | refresh | copy N | page
  local rows cols n CMDS=()
  case ${1:-} in
    page)
      check_page
      return 0
      ;;
    refresh)
      if [[ -t 1 ]]; then
        "$DOTFILES/Configs/.local/bin/sprite" play -m "checking for updates" "$SELF" check quiet || true
      else
        check_collect >/dev/null
      fi
      ;;
    copy)
      n=${2:-}
      status_render 100 >/dev/null
      if ! [[ $n =~ ^[0-9]+$ ]] || ((n < 1 || n > ${#CMDS[@]})); then die "usage: dots status copy N (1-${#CMDS[@]})"; fi
      printf '%s' "${CMDS[n - 1]}" | wl-copy
      printf 'Copied: %s\n' "${CMDS[n - 1]}"
      return 0
      ;;
    "") ;;
    *) die "usage: dots status [refresh|copy N|page]" ;;
  esac
  read -r rows cols < <(term_size)
  if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    status_render "$cols"
    while IFS= read -r n; do printf '%s %s%s\n' "$T_DIM" "$n" "$T_OFF"; done < <(wrap $((cols - 1)) "copy a command: dots status copy N · check again: dots status refresh")
  else
    status_render "$cols" | sed 's/\x1b\[[0-9;]*m//g'
  fi
}

cmd_add() {
  (($#)) || die "usage: dots add PKG... [-g GROUP]"
  local file=$PKG_DIR/$ADD_GROUP.txt p where desc new=() miss=() deps=()
  [[ $ADD_GROUP =~ ^[a-z0-9_-]+$ ]] || die "bad group name: $ADD_GROUP"
  for p; do
    where=$(list_of "$p")
    if [[ -n $where ]]; then info "$p is already listed in ${where#"$DOTFILES"/}"; else new+=("$p"); fi
    pacman -Qq -- "$p" &>/dev/null || miss+=("$p")
  done
  sudo_keepalive
  install_pkgs "${miss[@]}"
  [[ -f $file ]] || apply "create new list ${file#"$DOTFILES"/}" touch "$file"
  for p in "${new[@]}"; do
    if ((DRY_RUN)) || pacman -Qq -- "$p" &>/dev/null; then
      desc=$({ LC_ALL=C pacman -Qi -- "$p" || LC_ALL=C pacman -Si -- "$p"; } 2>/dev/null |
        sed -n 's/^Description *: //p' | head -1 || true)
      apply "add $p to ${file#"$DOTFILES"/}" record_pkg "$p" "$desc" "$file"
    fi
  done
  for p; do pacman -Qqd -- "$p" &>/dev/null && deps+=("$p"); done
  if ((${#deps[@]})); then quiet srun pacman -D --asexplicit "${deps[@]}"; fi
  return 0
}

cmd_remove() {
  (($#)) || die "usage: dots remove PKG..."
  local p f inst=() free=() confirm_args=()
  ((ASSUME_YES)) && confirm_args=(--noconfirm)
  for p; do
    for f in "$PKG_DIR"/*.txt; do
      in_list "$p" "$f" || continue
      apply "remove $p from ${f#"$DOTFILES"/}" unlist_pkg "$p" "$f"
    done
    pacman -Qq -- "$p" &>/dev/null && inst+=("$p")
  done
  if ((${#inst[@]} == 0)); then
    ok "Nothing to uninstall"
    return 0
  fi
  sudo_keepalive
  # Uninstall what nothing else needs; keep the rest as plain dependencies.
  # (pacman -Rp also knows when another provider still satisfies a dependency)
  for p in "${inst[@]}"; do
    if pacman -Rp -- "$p" &>/dev/null; then
      free+=("$p")
    else
      info "$p is still needed by: $(LC_ALL=C pacman -Qi -- "$p" | sed -n 's/^Required By *: //p') (kept, as a dependency)"
      quiet srun pacman -D --asdeps "$p"
    fi
  done
  if ((${#free[@]})); then srun pacman -Rns "${confirm_args[@]}" "${free[@]}"; fi
  return 0
}

cmd_prune() {
  local unl p free=() needed=() orph gone extra confirm_args=()
  ((ASSUME_YES)) && confirm_args=(--noconfirm)
  mapfile -t unl < <(unlisted)
  mapfile -t orph < <(orphans)
  # An unlisted package goes unless something requires it. pacman -Rp knows when
  # another package still provides what a dependency needs (ttf-dejavu vs ttf-font),
  # and checking against the ones already picked catches two packages that are
  # each other's only alternative.
  for p in "${unl[@]}"; do
    if pacman -Rp -- "${free[@]}" "$p" &>/dev/null; then free+=("$p"); else needed+=("$p"); fi
  done
  if ((${#free[@]} + ${#needed[@]} + ${#orph[@]} == 0)); then
    ok "Nothing to prune"
    return 0
  fi
  show_list "In no list, to be removed" "${free[@]}"
  show_list "Orphans, to be removed" "${orph[@]}"
  if ((${#free[@]} + ${#orph[@]})); then
    mapfile -t gone < <(pacman -Rsp --print-format '%n' "${free[@]}" "${orph[@]}" 2>/dev/null)
    mapfile -t extra < <(printf '%s\n' "${gone[@]}" | grep -vxF -f <(printf '%s\n' "${free[@]}" "${orph[@]}") || true)
    show_list "Removed with them (dependencies nothing else uses)" "${extra[@]}"
    ((${#gone[@]})) || gone=("${free[@]}" "${orph[@]}")
    info "That's ${#gone[@]} package(s), about $(LC_ALL=C pacman -Qi "${gone[@]}" 2>/dev/null |
      awk -F': ' '/^Installed Size/ { split($2, a, " "); v = a[1]; if (a[2] == "KiB") v /= 1024; if (a[2] == "GiB") v *= 1024; s += v } END { printf "%.0f", s }') MiB."
  fi
  if ((${#needed[@]})); then show_list "In no list but needed by other packages (kept, as dependencies)" "${needed[@]}"; fi
  ((DRY_RUN)) || sudo_keepalive
  # pacman shows the same list and asks before removing anything
  if ((${#free[@]} + ${#orph[@]})); then
    srun pacman -Rns "${confirm_args[@]}" "${free[@]}" "${orph[@]}" || {
      info "Nothing was removed."
      return 0
    }
  fi
  if ((${#needed[@]})); then quiet srun pacman -D --asdeps "${needed[@]}"; fi
  # anything the removal left without a user (the preview above already counts those)
  ((DRY_RUN)) || remove_orphans
  return 0
}

cmd_adopt() {
  (($#)) || die "usage: dots adopt PATH..."
  local path rel parent
  for path; do
    path=$(realpath -s -- "$path")
    rel=${path#"$HOME"/}
    parent=$(dirname -- "$rel")
    [[ $path == "$HOME"/* ]] || die "$path isn't inside your home"
    [[ -e $path && ! -L $path ]] || die "~/$rel doesn't exist or is already a symlink"
    [[ -e $HOME_SRC/$rel ]] && die "Configs/$rel already exists"
    is_real_dir "$rel" && die "~/$rel stays a real directory; adopt what's inside it"
    [[ $parent == . ]] || is_real_dir "$parent" ||
      die "~/$rel is inside ~/$parent, which dots links as a whole; adopt ~/$parent instead"
    apply "move ~/$rel to Configs/$rel" eval 'mkdir -p -- "$(dirname -- "$HOME_SRC/$rel")" && mv -- "$path" "$HOME_SRC/$rel"'
    apply "link ~/$rel" ln -s -- "$HOME_SRC/$rel" "$path"
  done
}

# Static checks, no root and no changes. The house rules are awk so they run without
# shellcheck; shellcheck, Hyprland's own validator and desktop-file-validate join in when installed.
LINT_FAILED=0
lint_report() { # label offenders: empty offenders = pass
  if [[ -z $2 ]]; then
    ok "$1"
  else
    printf '  %s✗%s %s\n' "$RED" "$RESET" "$1"
    sed 's/^/      /' <<<"$2"
    LINT_FAILED=1
  fi
}

# apply "..." eval '...': inside apply, $1 is `eval`, so the string must use named locals.
lint_apply_eval() {
  awk '
    { line = $0; while (line ~ /\\$/ && (getline nxt) > 0) { sub(/\\$/, " ", line); line = line nxt } }
    line !~ /^[[:space:]]*#/ && line ~ /apply .*[[:space:]]eval[[:space:]]/ && line ~ /\047[^\047]*\$(\{?[0-9@*])/ { print FILENAME": "line }
  ' "$SELF"
}

# A function must not end in `cond && action` (returns 1 under set -e when cond is false).
# [[ ]] and (( )) become T, quoted strings are dropped, so `[[ a && b ]]` and
# `apply ... eval 'a && b'` don't trip it; only a test, `have` or `booted` before && does.
lint_last_statement() {
  awk '
    function bare(l) {
      gsub(/\047[^\047]*\047/, "", l); gsub(/"[^"]*"/, "", l)
      gsub(/\[\[[^]]*\]\]/, "T", l); gsub(/\(\([^)]*\)\)/, "T", l)
      return l
    }
    function bad(l) {
      l = bare(l)
      return l !~ /\|\|/ && l ~ /(^|[;{][[:space:]]*|^[[:space:]]*!?[[:space:]]*)(T|have [^ ]+|booted|test [^&]*)[[:space:]]*&&/
    }
    /^[a-z_0-9]+\(\) \{.*; \}$/ { l = $0; sub(/^[^{]*\{/, "", l); if (bad(l)) print NR": "$0; next }
    /^}/ { if (bad(stmt)) print NR-1": "stmt }
    !/^[[:space:]]*(#|$)/ { stmt = (stmt ~ /(&&|\\)[[:space:]]*$/ ? stmt " " $0 : $0) }
  ' "$SELF"
}

# Every Hyprland bind carries a description: Super+/ lists them from `hyprctl binds`.
lint_binds() {
  local f files=()
  for f in "$HOME_SRC"/.config/hypr/hyprland.lua "$HOME_SRC"/.config/hypr/hyprland/*.lua; do
    if [[ -f $f ]]; then files+=("$f"); fi
  done
  ((${#files[@]})) || return 0
  awk '
    FNR == 1 { collecting = 0 }
    !collecting && /(^|[^[:alnum:]_.])(hl\.)?bind\(/ && !/^[[:space:]]*(--|local )/ { collecting = 1; depth = 0; text = ""; start = FNR }
    collecting {
      line = $0; sub(/--.*$/, "", line); text = text line "\n"
      o = gsub(/\(/, "(", line); c = gsub(/\)/, ")", line); depth += o - c
      if (depth <= 0) { if (text !~ /description[[:space:]]*=/) print FILENAME":"start; collecting = 0 }
    }
  ' "${files[@]}"
}

lint_tool() { # label command...: an external checker; shown only when it fails
  local label=$1 out
  shift
  if out=$("$@" 2>&1); then ok "$label"; else lint_report "$label" "${out:-failed}"; fi
}

cmd_lint() {
  header "Lint"
  lint_tool "bash -n dots" bash -n "$SELF"
  if have shellcheck; then
    lint_tool "shellcheck" shellcheck -x "$SELF" "$MIGRATIONS"/*.sh
  else
    warn "shellcheck is not installed: skipped (the house-rule checks below still run)"
  fi
  lint_report "apply ... eval strings use named locals, not \$1" "$(lint_apply_eval)"
  lint_report "no function ends in 'cond && action'" "$(lint_last_statement)"
  lint_report "every Hyprland bind has a description" "$(lint_binds)"
  if have Hyprland && [[ -f $HOME_SRC/.config/hypr/hyprland.lua ]]; then
    lint_tool "Hyprland --verify-config" bash -c \
      'Hyprland --verify-config -c "$1" | grep -q "config ok"' _ "$HOME_SRC/.config/hypr/hyprland.lua"
  fi
  local apps=("$HOME_SRC"/.local/share/applications/*.desktop)
  if have desktop-file-validate && ((${#apps[@]})); then
    lint_tool "desktop-file-validate" desktop-file-validate --no-hints "${apps[@]}"
  fi
  exit "$LINT_FAILED"
}

cmd_new_migration() {
  (($#)) || die 'usage: dots new-migration "what it does"'
  local slug file
  slug=$(tr '[:upper:]' '[:lower:]' <<<"$*" | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//')
  file=$MIGRATIONS/$(date +%s)-$slug.sh
  apply "create ${file#"$DOTFILES"/}" write_migration "$file" "$*"
}

write_migration() {
  mkdir -p -- "${1%/*}"
  printf '%s\n' "echo $(printf '%q' "$2")" "" \
    "# Runs once per machine, on dots update (bash -euo pipefail, from the repo root)." \
    "# Keep it safe to run twice: check before changing anything." >"$1"
}

# ── Main ────────────────────────────────────────────────────────────────────

# Not inside a checkout (e.g. run through curl): clone the repo, then hand over.
bootstrap() {
  local target=$HOME/.dotfiles
  if [[ ! -d $target/.git ]]; then
    have git || sudo pacman -S --needed --noconfirm git
    if ((DRY_RUN)); then target=$(mktemp -d)/dotfiles; fi
    git clone "$REPO_URL" "$target"
    git -C "$target" remote set-url --push origin "$REPO_PUSH_URL"
  fi
  # Under `curl | bash` stdin is the script itself: give the real run the terminal.
  [[ -t 0 ]] && exec bash "$target/dots" "${ORIG_ARGS[@]}"
  if { true </dev/tty; } 2>/dev/null; then exec bash "$target/dots" "${ORIG_ARGS[@]}" </dev/tty; fi
  exec bash "$target/dots" "${ORIG_ARGS[@]}" </dev/null
}

DRY_RUN=0 ASSUME_YES=0 ADD_GROUP=extras SEL_GROUPS=() ONLY=() SKIP=() POS=() MODE=install
ORIG_ARGS=("$@")
while (($#)); do
  case $1 in
    -n | --dry-run) DRY_RUN=1 ;;
    -y | --yes) ASSUME_YES=1 ;;
    -g | --group) ADD_GROUP=${2:?--group needs a name} && shift ;;
    --groups) IFS=, read -ra SEL_GROUPS <<<"${2:?--groups needs a list}" && shift ;;
    --only) IFS=, read -ra ONLY <<<"${2:?--only needs a list}" && shift ;;
    --skip) IFS=, read -ra SKIP <<<"${2:?--skip needs a list}" && shift ;;
    -h | --help) usage && exit 0 ;;
    -*) die "unknown option: $1 (see dots --help)" ;;
    *) POS+=("$1") ;;
  esac
  shift
done
CMD=${POS[0]:-}
ARGS=("${POS[@]:1}")

[[ -d $PKG_DIR ]] || bootstrap
for s in "${ONLY[@]}" "${SKIP[@]}"; do [[ -n ${STEP_TITLES[$s]:-} ]] || die "unknown step: $s"; done
for s in "${SEL_GROUPS[@]}"; do [[ -f $PKG_DIR/$s.txt ]] || die "unknown package list: $s"; done
trap '[[ -n ${SUDO_PID:-} ]] && kill "$SUDO_PID" 2>/dev/null; rm -rf "$RUN_DIR"' EXIT

case $CMD in
  install | update | add | remove | prune)
    start_log && take_lock
    # Afterwards, refresh the update check in the background for the bar (it
    # must not inherit the dots lock on fd 9, or it would block the next run).
    ((DRY_RUN)) || trap '[[ -n ${SUDO_PID:-} ]] && kill "$SUDO_PID" 2>/dev/null; rm -rf "$RUN_DIR"; setsid -f "$SELF" check quiet </dev/null >/dev/null 2>&1 9>&- || true' EXIT
    ;;
esac
case $CMD in
  install | update) cmd_install ;;
  status) cmd_status "${ARGS[@]}" ;;
  check) cmd_check "${ARGS[@]}" ;;
  link) header "Dotfiles" && step_link ;;
  adopt) cmd_adopt "${ARGS[@]}" ;;
  add) cmd_add "${ARGS[@]}" ;;
  remove) cmd_remove "${ARGS[@]}" ;;
  prune) cmd_prune ;;
  new-migration) cmd_new_migration "${ARGS[@]}" ;;
  lint) cmd_lint ;;
  "" | help) usage ;;
  *) die "unknown command: $CMD (see dots --help)" ;;
esac
